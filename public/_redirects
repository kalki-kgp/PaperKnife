# SPA routes serve the app shell at 200.
#
# Destination is "/" and not "/index.html": Workers static assets applies
# auto-trailing-slash handling after the rewrite, turning /index.html into a
# 307 to /, which would bounce every indexed deep link to the homepage.
#
# Anything not listed here falls through to not_found_handling ("404-page" in
# wrangler.jsonc), so scanner probes for /wp-admin, /.env and ~240 PHP shell
# paths get the ad-free 404 rather than an ad-bearing 200. See e03579b.
/merge                          /   200
/split                          /   200
/protect                        /   200
/unlock                         /   200
/compress                       /   200
/pdf-to-image                   /   200
/rotate-pdf                     /   200
/crop-pdf                       /   200
/pdf-to-text                    /   200
/rearrange-pdf                  /   200
/watermark                      /   200
/page-numbers                   /   200
/metadata                       /   200
/image-to-pdf                   /   200
/signature                      /   200
/repair                         /   200
/extract-images                 /   200
/grayscale                      /   200
/compare                        /   200
/word-to-pdf                    /   200
/about                          /   200
