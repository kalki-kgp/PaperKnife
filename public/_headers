# Security headers (all paths)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Nothing off-origin: no third-party script, style, font, image, frame or
  # connection is permitted. There is no host this policy could send a
  # user's PDF to.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Cache hashed assets aggressively (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache logos/images for 1 week
/logos/*
  Cache-Control: public, max-age=604800

# Cache icons for 1 week
/icons/*
  Cache-Control: public, max-age=604800

# App shell and service worker - always revalidate
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/share-target-sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/manifest.webmanifest
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Sitemap and robots
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
